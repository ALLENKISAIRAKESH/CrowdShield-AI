# CrowdShield AI Environment Configuration Template
# Copy this file to .env and configure for your local environment.

# AWS Region for Amazon Bedrock
AWS_REGION=us-east-1

# Optional: AWS Named Profile (leave empty to use default AWS credential chain or IAM role)
AWS_PROFILE=

# Amazon Bedrock Model ID
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Strands Decider 2B Service Endpoint
STRANDS_DECIDER_URL=http://127.0.0.1:8099

# Configurable Minimum Confidence Threshold for Automated Action Gate (0.00 to 1.00)
CROWDSHIELD_CONFIDENCE_THRESHOLD=0.70

# Logging Level (DEBUG, INFO, WARNING, ERROR)
CROWDSHIELD_LOG_LEVEL=INFO

# Request Timeout in Seconds
CROWDSHIELD_TIMEOUT_SECONDS=30.0
